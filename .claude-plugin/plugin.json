{
  "name": "deliberation",
  "description": "A second opinion from other models before you ship. Any host, any vendor, one verdict, and the disagreement stays visible. GPT (Codex), Gemini, Grok (xAI), local, and OpenRouter (400+) models review your plan or diff through eight expert subagents (Architect, Plan Reviewer, Scope Analyst, Code Reviewer, Security Analyst, Researcher, Debugger, Writing Editor) and the ask-gpt/ask-gemini/ask-grok/ask-openrouter/ask-all/consensus commands. Every provider advises (read-only); only Gemini can also implement (write).",
  "version": "4.6.1",
  "author": {
    "name": "Anton Babenko",
    "url": "https://github.com/antonbabenko"
  },
  "homepage": "https://github.com/antonbabenko/deliberation",
  "repository": "https://github.com/antonbabenko/deliberation",
  "license": "MIT",
  "keywords": ["second-opinion", "council", "consensus", "code-review", "delegation", "mcp", "codex", "gpt", "openai", "gemini", "antigravity", "agy", "google", "grok", "xai", "files", "experts", "subagents", "orchestration"],
  "mcpServers": {
    "deliberation-gemini": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/gemini/index.js"],
      "type": "stdio",
      "timeout": 1800000,
      "env": { "MCP_TOOL_TIMEOUT": "1800000" }
    },
    "deliberation-grok": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/grok/index.js"],
      "type": "stdio",
      "timeout": 1800000,
      "env": { "MCP_TOOL_TIMEOUT": "1800000" }
    },
    "deliberation-openrouter": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/openrouter/index.js"],
      "type": "stdio",
      "timeout": 1800000,
      "env": { "MCP_TOOL_TIMEOUT": "1800000" }
    },
    "deliberation": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/mcp/index.js"],
      "type": "stdio",
      "timeout": 1800000,
      "env": { "MCP_TOOL_TIMEOUT": "1800000" }
    }
  }
}
