---
// The mark, inline so it needs no request and keeps its own five colours in both themes.
interface Props {
  title?: string
}
const { title } = Astro.props
---
<svg viewBox="0 0 64 64" width="22" height="22" role={title ? 'img' : undefined} aria-label={title} aria-hidden={title ? undefined : 'true'}>
  <rect width="64" height="64" rx="10" fill="#15171a" />
  <g fill="none" stroke-width="6.5" stroke-linecap="round">
    <path d="M11.5 12H28.5A20 20 0 0 1 48.5 32" stroke="#7cb4fc" />
    <path d="M11.5 32H48.5" stroke="#c39dee" />
    <path d="M11.5 52H28.5A20 20 0 0 0 40.81 47.76" stroke="#5ecbcb" />
  </g>
  <circle cx="48.5" cy="32" r="7.47" fill="#e8e6e0" />
</svg>
