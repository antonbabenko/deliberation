---
// Page shell: SEO head, skip link, top bar, main, footer, search dialog. `main` is the
// only part Pagefind indexes (data-pagefind-body); a noindex page is left out.
import '../styles/site.css'
import '../styles/chrome.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Mark from '../components/Mark.astro'
import JsonLd from '../components/JsonLd.astro'
import Analytics from '../components/Analytics.astro'
import Search from '../components/Search.astro'
import { site } from '../pages.config.ts'
import { BASE, OG_IMAGE, absolute, routeOf } from '../lib/seo.ts'
import { readRepoJson } from '../lib/repo.ts'

interface Props {
  title: string
  description: string
  jsonLd?: Record<string, unknown>[]
  noindex?: boolean
}
const { title, description, jsonLd = [], noindex = false } = Astro.props
const fullTitle = title === site.name || title.startsWith(`${site.name} `) ? title : `${title} | ${site.name}`
const canonical = absolute(Astro.url.pathname)
// The released version, read from the repository root at build time.
const { version } = readRepoJson<{ version: string }>('version.json')
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f0efea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1f2124" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={`${BASE}assets/logo-mark.svg`} />
    <link rel="sitemap" href={`${BASE}sitemap-index.xml`} />
    <link rel="alternate" type="text/plain" title="llms.txt" href={`${BASE}llms.txt`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: a second opinion from other models before you ship.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    {jsonLd.map((data) => <JsonLd data={data} />)}
    <!-- Before first paint: script-only controls show, and the capture may draw once. -->
    <script is:inline>
      (function (c) {
        c.add('js')
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) c.add('motion')
      })(document.documentElement.classList)
    </script>
    <!-- Privacy-friendly analytics by Plausible -->
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="brand-line">
        <a class="brand" href={BASE}><Mark /><span>{site.name}</span></a>
        <a class="ver" href={routeOf('changelog')} aria-label={`Version ${version}, changelog`}>v{version}</a>
      </div>
      <Nav />
    </header>
    <main id="main" data-pagefind-body={noindex ? undefined : true}>
      <slot />
    </main>
    <Footer />
    <Search />
    <script>
      import '../scripts/site.js'
      import '../scripts/scrollspy.js'
    </script>
  </body>
</html>
